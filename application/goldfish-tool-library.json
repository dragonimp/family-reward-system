{
  "services": [
    {
      "name": "family-reward-mcp",
      "title": "家庭积分应用",
      "description": "家庭积分应用 MCP：18 个独立工具统一要求 parent_user_id；孩子和积分写操作仅允许所属家长，积分查询覆盖家长创建或加入的全部家庭，规则按家长隔离。",
      "baseUrl": "https://happylife.ai.impx.net",
      "mcpEndpoint": "/api/mcp",
      "httpEndpoint": "https://happylife.ai.impx.net/api/mcp",
      "tools": [
        {
          "name": "family_reward_add_child",
          "description": "新增孩子：创建孩子档案并可设置初始积分/现金/物品。 必须传 parent_user_id；查询按该家长的可见范围返回，写操作仅允许处理该家长自己的孩子、记录或规则，越权返回权限不足。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "孩子姓名（必填）"
              },
              "family_group_id": {
                "type": "integer",
                "description": "圈子ID；不传则使用默认圈子"
              },
              "note": {
                "type": "string",
                "description": "备注"
              },
              "status": {
                "type": "string",
                "description": "状态：active / inactive"
              },
              "score": {
                "type": "number",
                "description": "初始积分（默认为 0）"
              },
              "cash": {
                "type": "number",
                "description": "初始现金（默认为 0）"
              },
              "items": {
                "type": "integer",
                "description": "初始物品数（默认为 0）"
              },
              "parent_user_id": {
                "type": "string",
                "description": "家长用户名或家长应用用户编号（必填），用于数据范围和操作权限校验"
              }
            },
            "required": [
              "parent_user_id",
              "name"
            ]
          }
        },
        {
          "name": "family_reward_update_child",
          "description": "修改孩子信息：按 id 或姓名定位后更新。至少更新一个字段。 必须传 parent_user_id；查询按该家长的可见范围返回，写操作仅允许处理该家长自己的孩子、记录或规则，越权返回权限不足。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "family_group_id": {
                "type": "integer",
                "description": "圈子ID；用于缩小孩子姓名定位范围"
              },
              "child_id": {
                "type": "integer",
                "description": "孩子ID"
              },
              "child_name": {
                "type": "string",
                "description": "孩子姓名（用于定位）"
              },
              "name": {
                "type": "string",
                "description": "更新后的姓名"
              },
              "note": {
                "type": "string",
                "description": "更新后的备注"
              },
              "status": {
                "type": "string",
                "description": "更新后的状态，示例：active / inactive"
              },
              "score": {
                "type": "number",
                "description": "更新后的积分余额（覆盖，不是增量）"
              },
              "cash": {
                "type": "number",
                "description": "更新后的现金余额（覆盖，不是增量）"
              },
              "items": {
                "type": "integer",
                "description": "更新后的物品数（覆盖，不是增量）"
              },
              "parent_user_id": {
                "type": "string",
                "description": "家长用户名或家长应用用户编号（必填），用于数据范围和操作权限校验"
              }
            },
            "required": [
              "parent_user_id"
            ]
          }
        },
        {
          "name": "family_reward_query_children",
          "description": "查询孩子列表：传 family_group_id 返回该圈子的全部孩子；也可继续传 child_id 或 child_name 定位单个孩子。若按某个孩子查询返回 ok:false/未找到，智能体必须再调用 family_reward_list_children（只传 family_group_id）取得完整孩子清单，并把用户输入与清单中的 ID/姓名逐一比较后再回复，避免别名、错别字或输入差异导致误判。 必须传 parent_user_id；查询按该家长的可见范围返回，写操作仅允许处理该家长自己的孩子、记录或规则，越权返回权限不足。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "family_group_id": {
                "type": "integer",
                "description": "圈子ID；可选。只传此字段时返回该圈子全部孩子"
              },
              "child_id": {
                "type": "integer",
                "description": "孩子ID（可选）。未找到时不要直接结束，应再查完整孩子清单进行对比"
              },
              "child_name": {
                "type": "string",
                "description": "孩子姓名（可选）。未找到时不要直接结束，应再查完整孩子清单进行对比"
              },
              "parent_user_id": {
                "type": "string",
                "description": "家长用户名或家长应用用户编号（必填），用于数据范围和操作权限校验"
              }
            },
            "required": [
              "parent_user_id"
            ]
          }
        },
