<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>LinkoFamily</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Linko Moment</ApplicationTitle>
    <ApplicationId>net.impx.happylife</ApplicationId>
    <ApplicationDisplayVersion>1.0.28</ApplicationDisplayVersion>
    <ApplicationVersion>37</ApplicationVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <AgentIdentityNativeClientProject Condition="'$(AgentIdentityNativeClientProject)' == ''">$(MSBuildThisFileDirectory)../../../AgentIdentity/src/AgentIdentity.NativeClient/AgentIdentity.NativeClient.csproj</AgentIdentityNativeClientProject>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/familyicon.png" BaseSize="512,512" />
    <MauiSplashScreen Include="Resources/AppIcon/familyicon.png" Color="#0F766E" BaseSize="128,128" />
    <MauiFont Include="Resources/Fonts/*" />
    <MauiAsset Include="../../frontend/public/legal/linko-family-privacy.html" LogicalName="linko-family-privacy.html" />
    <ProjectReference Include="$(AgentIdentityNativeClientProject)" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>
  <PropertyGroup><AtlasSdkRoot Condition="'$(AtlasSdkRoot)' == ''">$(MSBuildThisFileDirectory)../../../Atlas</AtlasSdkRoot></PropertyGroup>
  <ItemGroup><ProjectReference Include="$(AtlasSdkRoot)/sdk/Atlas.Releases.Maui/Atlas.Releases.Maui.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="$([System.IO.Path]::GetDirectoryName('$(AgentIdentityNativeClientProject)'))/../AgentIdentity.Maui/AgentIdentity.Maui.csproj" /></ItemGroup>
  <PropertyGroup><MyVncSdkRoot Condition="'$(MyVncSdkRoot)' == ''">$(MSBuildThisFileDirectory)../../../MyVnc</MyVncSdkRoot><MyVncNativeRoot Condition="'$(MyVncNativeRoot)' == ''">$(MyVncSdkRoot)/artifacts/native-rtc/android-arm64</MyVncNativeRoot></PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MyVncSdkRoot)/sdk/MyVnc.Realtime.Client/RealtimeFileTransfer.cs" Link="Connect/RealtimeFileTransfer.cs" />
    <Compile Include="$(MyVncSdkRoot)/sdk/MyVnc.Realtime.Client/RealtimeFileRelay.cs" Link="Connect/RealtimeFileRelay.cs" />
    <AndroidNativeLibrary Include="$(MyVncNativeRoot)/libmyvnc-rtc.so" Abi="arm64-v8a" />
    <MauiAsset Include="$(MyVncNativeRoot)/licenses/**" LogicalName="ConnectLicenses/%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiAsset Include="$(MyVncNativeRoot)/NOTICE.txt" LogicalName="ConnectLicenses/NOTICE.txt" />
    <MauiAsset Include="$(MyVncNativeRoot)/source-commit.txt" LogicalName="ConnectLicenses/source-commit.txt" />
  </ItemGroup>
</Project>
