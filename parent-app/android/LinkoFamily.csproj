<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>LinkoFamily</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Linko Dear</ApplicationTitle>
    <ApplicationId>net.impx.happylife.parent.android</ApplicationId>
    <ApplicationDisplayVersion>20261011-android-parent.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <AgentIdentityNativeClientProject Condition="'$(AgentIdentityNativeClientProject)' == ''">$(MSBuildThisFileDirectory)../../../AgentIdentity/src/AgentIdentity.NativeClient/AgentIdentity.NativeClient.csproj</AgentIdentityNativeClientProject>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/familyicon.png" BaseSize="512,512" />
    <MauiSplashScreen Include="Resources/AppIcon/familyicon.png" Color="#0F766E" BaseSize="128,128" />
    <MauiFont Include="Resources/Fonts/*" />
    <ProjectReference Include="$(AgentIdentityNativeClientProject)" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>
</Project>
