<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSApplicationQueriesSchemes</key>
	<array><string>iosamap</string><string>baidumap</string><string>qqmap</string><string>comgooglemaps</string></array>
	<key>NSMotionUsageDescription</key>
	<string>在您开始运动后读取本机步数和估算距离，用于散步、慢跑等运动记录。</string>
	<key>NSCameraUsageDescription</key>
	<string>用于拍摄活动照片和视频、拍摄并识别小小窝的物品，或扫描手表配对二维码。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>录制活动视频时采集声音。</string>
	<key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
	<true/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>自动匹配您已共享照片和视频的本机原件，核验一致后继续原下载请求。只读取您授权的照片，不修改或删除系统相册内容。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>将您拍摄的照片和视频保存到系统相册，保留原件并共享到活动。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>允许获取位置，用于活动拍照、打卡、查找附近餐厅和记录运动轨迹。您创建或加入好友运动时，持有邀请码并已登录的人可查看这次运动的轨迹。活动位置共享单独开启，离开活动或进入后台时停止。</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>Linko Moment</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Linko Moment</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>net.impx.happylife.login</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>linkofamily</string>
				<string>linkomoment</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>HappyLifeIdentityURL</key>
	<string>https://auth.ai.xmkurt.com</string>
	<key>HappyLifeServiceURL</key>
	<string>https://happylife.ai.xmkurt.com</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>通过 Linko Connect 与活动成员的设备连接，传输您共享的照片和视频原文件。</string>
	<key>NSHealthShareUsageDescription</key>
	<string>读取您授权的心率、活动能量、步数、距离和手表体能训练，用于显示本次运动数据。</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>将您主动记录的手表运动保存到 Apple 健康，用于在手机和手表查看运动记录。</string>
</dict>
</plist>
