"NSCameraUsageDescription" = "Take activity photos and videos, or scan a watch pairing QR code when you choose these features.";
"NSMicrophoneUsageDescription" = "Record sound when you choose to record an activity video.";
"NSPhotoLibraryUsageDescription" = "Find the local originals of photos and videos you shared so you can download the matching original. Only the photos you authorize are read; your library is not changed or deleted.";
"NSPhotoLibraryAddUsageDescription" = "Save the photos and videos you capture to your photo library so you can keep and share the originals.";
"NSLocationWhenInUseUsageDescription" = "Allow location access for activity photos, check-ins, nearby dining, and workout routes. When you create or join a shared workout, signed-in people with the invite code can view its route. Activity location sharing is separate and stops when you leave the activity or the app enters the background.";
"NSLocalNetworkUsageDescription" = "Connect to activity members’ devices through Linko Connect to transfer the original photos and videos you share.";
"NSMotionUsageDescription" = "Read steps and estimated distance after you start exercise to record walks and runs.";
"NSHealthShareUsageDescription" = "Read the heart rate, active energy, steps, distance and Watch workouts you authorize to display your exercise data.";
"NSHealthUpdateUsageDescription" = "Save the Watch workouts you record to Apple Health so you can view them on your phone and watch.";
