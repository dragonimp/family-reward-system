  {
    "recipeId": "b984c313-ceb8-5fad-ab72-0254b3ad7f20",
    "name": "香菇南瓜饭",
    "category": "rice",
    "description": "两人份的香菇南瓜饭，用常见食材制作。",
    "servings": 2,
    "duration": 35,
    "difficulty": "简单",
    "ingredients": [
      {
        "name": "大米",
        "quantity": 150,
        "unit": "克"
      },
      {
        "name": "水",
        "quantity": 220,
        "unit": "毫升"
      },
      {
        "name": "南瓜",
        "quantity": 180,
        "unit": "克"
      },
      {
        "name": "鲜香菇",
        "quantity": 100,
        "unit": "克"
      },
      {
        "name": "盐",
        "quantity": 2,
        "unit": "克"
      }
    ],
    "preparation": [
      "大米淘洗沥水，南瓜去皮去籽切小丁，香菇洗净切片。"
    ],
    "steps": [
      {
        "number": 1,
        "action": "装入内锅",
        "ingredients": [
          "大米",
          "水",
          "南瓜",
          "鲜香菇",
          "盐"
        ],
        "utensils": [
          "电饭煲",
          "量杯"
        ],
        "instruction": "米、水、南瓜丁和香菇片放入电饭煲，轻轻拌匀；米的用水量优先按包装及电饭煲说明调整。",
        "illustrationUrl": null
      },
      {
        "number": 2,
        "action": "煮熟焖透",
        "ingredients": [
          "米饭",
          "南瓜",
          "鲜香菇"
        ],
        "utensils": [
          "电饭煲"
        ],
        "instruction": "启动正常煮饭程序。结束后确认米无硬芯、南瓜软透、香菇完全熟透，再按说明焖5分钟。",
        "illustrationUrl": null
      },
      {
        "number": 3,
        "action": "翻松盛饭",
        "ingredients": [
          "香菇南瓜饭"
        ],
        "utensils": [
          "饭勺",
          "碗"
        ],
        "instruction": "用饭勺翻松熟饭，均匀混合后盛入两只碗，趁热食用。",
        "illustrationUrl": null
      }
    ],
    "notes": [
      "处理食材前后洗手；生熟食材和器具分开。",
      "用量为两人份参考，火力、锅具和食材大小会影响实际时间；以熟度说明为准。",
      "食用前核对鸡蛋、乳制品、芝麻、小麦等过敏原；有过敏史时不要使用相关食材。"
    ],
    "coverImage": null,
