{
  "recipeId": "8abdcac3-3bab-55c2-99a5-31cfc6a277cc",
  "name": "家庭版姜母鸭",
  "category": "rice",
  "description": "适合配米饭的无酒家庭版姜母鸭，以老姜和芝麻油慢炖，三人份。",
  "servings": 3,
  "duration": 90,
  "difficulty": "家常",
  "ingredients": [
    {
      "name": "带骨鸭肉",
      "quantity": 750,
      "unit": "克"
    },
    {
      "name": "老姜",
      "quantity": 120,
      "unit": "克"
    },
    {
      "name": "芝麻油",
      "quantity": 20,
      "unit": "毫升"
    },
    {
      "name": "生抽",
      "quantity": 20,
      "unit": "毫升"
    },
    {
      "name": "老抽",
      "quantity": 5,
      "unit": "毫升"
    },
    {
      "name": "冰糖",
      "quantity": 8,
      "unit": "克"
    },
    {
      "name": "热水",
      "quantity": 700,
      "unit": "毫升"
    }
  ],
  "preparation": [
    "鸭肉请商家斩成约4厘米块，去掉残留骨渣，用厨房纸吸干；不要冲洗生禽造成飞溅。",
    "老姜刷净切成约3毫米厚片，准备带盖厚底锅；处理生鸭后洗手并清洁刀具和砧板。"
  ],
  "steps": [
    {
      "number": 1,
      "action": "煸香老姜",
      "ingredients": [
        "老姜",
        "芝麻油"
      ],
      "utensils": [
        "带盖厚底锅",
        "锅铲"
      ],
      "instruction": "冷锅加入芝麻油和姜片，小火煸炒5至8分钟，至姜片边缘微卷、香气出来；避免油冒烟或姜片焦黑。",
      "illustrationUrl": null
    },
    {
      "number": 2,
      "action": "煸炒鸭肉",
      "ingredients": [
        "带骨鸭肉"
      ],
      "utensils": [
        "带盖厚底锅",
        "锅铲"
      ],
      "instruction": "转中火加入鸭块，翻炒8至10分钟至表面变色并略微金黄；避免热油飞溅，此时鸭肉内部尚未熟透。",
      "illustrationUrl": null
    },
    {
      "number": 3,
      "action": "调味加水",
      "ingredients": [
        "生抽",
        "老抽",
        "冰糖",
        "热水"
      ],
      "utensils": [
        "带盖厚底锅",
        "锅铲"
      ],
      "instruction": "加入生抽、老抽、冰糖翻匀，沿锅边缓慢倒入热水，水量接近没过鸭肉；大火煮开。",
      "illustrationUrl": null
    },
    {
      "number": 4,
      "action": "加盖慢炖",
      "ingredients": [
        "鸭肉",
        "姜片",
        "汤汁"
      ],
      "utensils": [
        "带盖厚底锅",
        "锅铲",
        "食品温度计"
      ],
      "instruction": "转小火加盖炖50至60分钟，每15分钟检查并翻动；水少时补热水。用食品温度计测最厚鸭肉中心，避开骨头，至少达到74℃，并继续炖至肉软嫩。",
      "illustrationUrl": null
    },
    {
      "number": 5,
      "action": "收汁盛盘",
      "ingredients": [
        "姜母鸭"
      ],
      "utensils": [
        "带盖厚底锅",
        "锅铲"
      ],
      "instruction": "揭盖转中火收汁5至10分钟，轻轻翻动防粘；保留少量汤汁拌饭。尝熟汤汁后按口味调整，关火盛盘，注意锅和汤汁烫手。",
      "illustrationUrl": null
    }
  ],
  "notes": [
    "本版本不加米酒，芝麻和酱油中的大豆、小麦属于需核对的过敏原。",
    "时间为参考，以鸭肉熟透软嫩为准；老鸭需延长炖煮，及时补热水防止烧干。",
    "食材用量为三人份，可另配米饭；米饭不计入本菜食材和制作时间。"
  ],
  "coverImage": null,
  "illustrationStatus": "unavailable",
  "recipeVersion": 1,
  "source": "Linko Moment 原创家庭试行菜谱；尚待人工烹饪复核。",
  "mealPreferences": [
    "lunch",
    "dinner"
  ]
}
