  {
    "recipeId": "937fdec9-f486-58e7-b845-11d63770f1c6",
    "name": "南瓜小米粥",
    "version": 1,
    "steps": [
      {
        "number": 1,
        "action": "煮开",
        "ingredients": [
          "小米",
          "南瓜",
          "水"
        ],
        "utensils": [
          "汤锅",
          "长柄勺"
        ],
        "instruction": "水烧开，放入谷物和蔬菜，搅拌后转小火。",
        "illustrationUrl": null
      },
      {
        "number": 2,
        "action": "慢煮",
        "ingredients": [
          "粥"
        ],
        "utensils": [
          "汤锅",
          "长柄勺"
        ],
        "instruction": "锅盖留缝，小火煮25至35分钟，期间搅拌并留意防溢。燕麦片若包装要求更短时间，先煮软蔬菜再按包装时间加入。",
        "illustrationUrl": null
      },
      {
        "number": 3,
        "action": "检查熟度",
        "ingredients": [
          "粥"
        ],
        "utensils": [
          "勺子"
        ],
        "instruction": "确认谷物无硬芯、蔬菜可轻松压碎；过稠时加少量开水再煮沸。",
        "illustrationUrl": null
      },
      {
        "number": 4,
        "action": "盛出",
        "ingredients": [
          "粥"
        ],
        "utensils": [
          "碗"
        ],
        "instruction": "关火后盛出，放至适口温度再吃，小心烫伤。",
        "illustrationUrl": null
      }
    ]
  },
